# Copy to .env and fill in. Auto-loaded by the engine (bin/cli.py and src/embedding.py);
# launchd/cron jobs read it too, so secrets and PATH fixes both live here. chmod 600 .env.

# OpenAI-compatible API — needed when settings.embedding.backend or model_access.provider is "api".
CLAUDE_MEMORY_API_BASE_URL=
CLAUDE_MEMORY_API_KEY=

# Absolute path to the codex binary. Only needed for scheduled jobs (launchd/cron don't
# inherit your shell PATH) or when codex isn't on PATH.
#CLAUDE_MEMORY_CODEX_BIN=

# Fallback CLI command for call paths that don't pass one explicitly (an explicit
# command — e.g. from settings.model_access.cli_cmd — always wins). Rarely needed.
#CLAUDE_MEMORY_MODEL_CMD=
